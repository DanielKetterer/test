# Kernel config fragment applied on top of arch/arm/configs/vexpress_defconfig
# Only add/override what the base defconfig doesn't already set.

# Expose running config via /proc/config.gz — handy for debugging
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# OverlayFS — useful for experiments without dirtying the rootfs
CONFIG_OVERLAY_FS=y

# SquashFS + XZ — common read-only rootfs format
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y

# SysRq — lets you recover a locked-up guest
CONFIG_MAGIC_SYSRQ=y

# Expose kernel symbols for GDB / ftrace work
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y

# Ftrace infrastructure (no overhead until enabled at runtime)
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
